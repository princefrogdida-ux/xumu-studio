# M4: defaults to MockProvider. Keys are read only by API/worker.
PORT=4311
# Default: ./data/studio.sqlite. Relative paths resolve from the project root.
STUDIO_DATA_DIR=data

# Keep false for development without paid calls. Restart BOTH API and worker after configuration changes.
STUDIO_REAL_CALLS_ENABLED=false

# Full API base including /v1 if required by the relay. HTTPS only; no default relay/model.
STUDIO_TEXT_BASE_URL=
STUDIO_TEXT_API_KEY=
STUDIO_TEXT_MODEL=
# prompt (most compatible), json_object or json_schema, only if supported by the selected model.
STUDIO_TEXT_FORMAT=prompt
STUDIO_TEXT_TIMEOUT_MS=120000

STUDIO_IMAGE_BASE_URL=
STUDIO_IMAGE_API_KEY=
STUDIO_IMAGE_MODEL=
# json: images:[{image_url:data-url}] ; multipart: repeated image[] file parts.
STUDIO_IMAGE_EDIT_FORMAT=json
# Set only after verifying the relay/model documentation. No reference-image support is assumed.
STUDIO_IMAGE_MAX_REFERENCES=0
STUDIO_IMAGE_MAX_COUNT=1
# Do not map 16:9 to a 3:2 size. Configure exact sizes only if the model supports them.
STUDIO_IMAGE_SIZES='{"1:1":"1024x1024","3:2":"1536x1024","2:3":"1024x1536"}'
# Exact comma-separated CDN hostnames for URL outputs; no wildcards, no schemes, no authorization forwarded.
STUDIO_IMAGE_MEDIA_HOSTS=
STUDIO_IMAGE_TIMEOUT_MS=120000

# No universal video API. Copy the example profile and adapt it to the relay's actual documentation.
STUDIO_VIDEO_BASE_URL=
STUDIO_VIDEO_API_KEY=
STUDIO_VIDEO_MODEL=
STUDIO_VIDEO_PROFILE_FILE=
STUDIO_VIDEO_MEDIA_HOSTS=
STUDIO_VIDEO_POLL_MS=5000
STUDIO_VIDEO_TIMEOUT_MS=120000
